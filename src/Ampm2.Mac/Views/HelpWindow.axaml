<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ampm2.Mac.Views.HelpWindow"
        x:CompileBindings="False"
        Title="ampm2 Help" Width="940" Height="660" MinWidth="700" MinHeight="420"
        Icon="/Assets/icon-256.png" WindowStartupLocation="CenterOwner">
    <Grid Margin="18" ColumnDefinitions="270,14,*">

        <!-- topics -->
        <Border Classes="card" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Image Source="/Assets/icon-64.png" Width="26" Height="26"/>
                        <TextBlock Text="ampm2 Help" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="SearchBox" PlaceholderText="Search help">
                        <TextBox.InnerLeftContent><PathIcon Data="{StaticResource IcSearch}" Width="13" Height="13" Margin="9,0,0,0" Foreground="{DynamicResource TextFaint}"/></TextBox.InnerLeftContent>
                    </TextBox>
                </StackPanel>
                <TextBlock x:Name="NoResults" DockPanel.Dock="Top" Text="No topic matches." Classes="dim" Margin="8,4" IsVisible="False"/>
                <ListBox x:Name="TopicList" Classes="rows" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,7">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- article -->
        <Border Grid.Column="2" Classes="card">
            <ScrollViewer x:Name="ArticleScroll" Padding="28,22,28,26">
                <StackPanel x:Name="Article" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Classes="dim" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Panel>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,6" TextWrapping="Wrap" IsVisible="{Binding IsHeading}"/>
                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10" IsVisible="{Binding IsParagraph}"/>
                                    <DockPanel Margin="2,0,0,7" IsVisible="{Binding IsBullet}">
                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,7,11,0" VerticalAlignment="Top"/>
                                        <TextBlock TextWrapping="Wrap" LineHeight="20">
                                            <Run Text="{Binding Term}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding DisplayText}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8" IsVisible="{Binding IsStep}">
                                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" Margin="0,1,0,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,7" IsVisible="{Binding IsKey}">
                                        <Panel DockPanel.Dock="Left" MinWidth="104" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,2" CornerRadius="5" Padding="7,1,7,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Term}" Classes="mono"/>
                                            </Border>
                                        </Panel>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" Margin="0,1,0,0"/>
                                    </DockPanel>
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,9" Margin="0,4,0,12" IsVisible="{Binding IsNote}">
                                        <DockPanel>
                                            <PathIcon DockPanel.Dock="Left" Data="{StaticResource IcInfo}" Width="14" Height="14" Foreground="{DynamicResource Accent}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Background="{DynamicResource LogBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,2,0,12" IsVisible="{Binding IsCode}">
                                        <SelectableTextBlock Text="{Binding Text}" Classes="mono" TextWrapping="Wrap"/>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
