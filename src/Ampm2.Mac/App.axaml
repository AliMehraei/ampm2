<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ampm2.Mac.App"
             Name="ampm2"
             RequestedThemeVariant="Default">

    <!-- macOS app menu (ampm2 ▸ About ampm2 / Settings…) -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About ampm2" Click="About_Click"/>
            <NativeMenuItem Header="Settings…" Gesture="Cmd+OemComma" Click="Settings_Click"/>
            <NativeMenuItem Header="ampm2 Help" Gesture="Cmd+Shift+OemQuestion" Click="Help_Click"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon-44.png" ToolTipText="ampm2" Clicked="Tray_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open ampm2" Click="Open_Click"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Restart all" Click="RestartAll_Click"/>
                        <NativeMenuItem Header="Stop all" Click="StopAll_Click"/>
                        <NativeMenuItem Header="Save process list" Click="Save_Click"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Help" Click="Help_Click"/>
                        <NativeMenuItem Header="About ampm2" Click="About_Click"/>
                        <NativeMenuItem Header="Quit ampm2" Click="Quit_Click"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Bg" Color="#0E1015"/>
                    <SolidColorBrush x:Key="Surface" Color="#151820"/>
                    <SolidColorBrush x:Key="Surface2" Color="#1C212B"/>
                    <SolidColorBrush x:Key="Line" Color="#272C38"/>
                    <SolidColorBrush x:Key="Hover" Color="#1F2431"/>
                    <SolidColorBrush x:Key="Selected" Color="#262D40"/>
                    <SolidColorBrush x:Key="Text" Color="#E7EAF0"/>
                    <SolidColorBrush x:Key="TextDim" Color="#8B93A5"/>
                    <SolidColorBrush x:Key="TextFaint" Color="#5C6475"/>
                    <SolidColorBrush x:Key="Accent" Color="#8087FF"/>
                    <SolidColorBrush x:Key="AccentSoft" Color="#2B2F5E"/>
                    <SolidColorBrush x:Key="Overlay" Color="#B0000000"/>
                    <SolidColorBrush x:Key="LogBg" Color="#0B0D11"/>
                    <SolidColorBrush x:Key="LogErr" Color="#FF8A8A"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Bg" Color="#F4F5F9"/>
                    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Surface2" Color="#F0F2F7"/>
                    <SolidColorBrush x:Key="Line" Color="#E1E4EC"/>
                    <SolidColorBrush x:Key="Hover" Color="#F2F4FA"/>
                    <SolidColorBrush x:Key="Selected" Color="#E9EBFF"/>
                    <SolidColorBrush x:Key="Text" Color="#141821"/>
                    <SolidColorBrush x:Key="TextDim" Color="#5E677A"/>
                    <SolidColorBrush x:Key="TextFaint" Color="#98A0B1"/>
                    <SolidColorBrush x:Key="Accent" Color="#5458E8"/>
                    <SolidColorBrush x:Key="AccentSoft" Color="#E6E7FD"/>
                    <SolidColorBrush x:Key="Overlay" Color="#66101320"/>
                    <SolidColorBrush x:Key="LogBg" Color="#FAFBFD"/>
                    <SolidColorBrush x:Key="LogErr" Color="#C9323A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Material Design icon paths (24x24) -->
            <StreamGeometry x:Key="IcPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
            <StreamGeometry x:Key="IcPause">M14,19H18V5H14M6,19H10V5H6V19Z</StreamGeometry>
            <StreamGeometry x:Key="IcStop">M18,18H6V6H18V18Z</StreamGeometry>
            <StreamGeometry x:Key="IcRestart">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
            <StreamGeometry x:Key="IcDelete">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
            <StreamGeometry x:Key="IcLogs">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M8,12V14H16V12H8M8,16V18H13V16H8Z</StreamGeometry>
            <StreamGeometry x:Key="IcAdd">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
            <StreamGeometry x:Key="IcSave">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</StreamGeometry>
            <StreamGeometry x:Key="IcGear">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
            <StreamGeometry x:Key="IcHelp">M15.07,11.25L14.17,12.17C13.45,12.89 13,13.5 13,15H11V14.5C11,13.39 11.45,12.39 12.17,11.67L13.41,10.41C13.78,10.05 14,9.55 14,9C14,7.89 13.1,7 12,7A2,2 0 0,0 10,9H8A4,4 0 0,1 12,5A4,4 0 0,1 16,9C16,9.88 15.64,10.67 15.07,11.25M13,19H11V17H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,6.47 17.5,2 12,2Z</StreamGeometry>
            <StreamGeometry x:Key="IcInfo">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
            <StreamGeometry x:Key="IcFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
            <StreamGeometry x:Key="IcExport">M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z</StreamGeometry>
            <StreamGeometry x:Key="IcImport">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
            <StreamGeometry x:Key="IcSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
            <StreamGeometry x:Key="IcClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
            <StreamGeometry x:Key="IcBolt">M7,2V13H10V22L17,10H13L17,2H7Z</StreamGeometry>
            <StreamGeometry x:Key="IcList">M3,4H7V8H3V4M9,5V7H21V5H9M3,10H7V14H3V10M9,11V13H21V11H9M3,16H7V20H3V16M9,17V19H21V17H9</StreamGeometry>
            <StreamGeometry x:Key="IcBookmark">M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z</StreamGeometry>

            <FontFamily x:Key="Mono">Menlo, SF Mono, Cascadia Mono, Consolas, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{DynamicResource TextDim}"/></Style>
        <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{DynamicResource TextFaint}"/></Style>
        <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource TextDim}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="TextBox.mono"><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="SelectableTextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="FontSize" Value="12"/></Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2,9,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.segments">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3"/>
        </Style>

        <!-- buttons -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#E0484E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E0484E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <!-- icon-only buttons are announced (VoiceOver / UI Automation) by their tooltip -->
        <Style Selector="Button.icon">
            <Setter Property="AutomationProperties.Name" Value="{Binding $self.(ToolTip.Tip)}"/>
        </Style>
        <Style Selector="Button.icon PathIcon"><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/></Style>
        <Style Selector="Button PathIcon"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/></Style>
        <Style Selector="Button.colhead">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
        </Style>

        <!-- segmented toggle buttons -->
        <Style Selector="ToggleButton.seg">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- process rows -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selected}"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selected}"/>
        </Style>
        <Style Selector="ListBox.logs ListBoxItem">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <!-- row actions appear on hover/selection -->
        <Style Selector="ListBoxItem StackPanel.actions"><Setter Property="Opacity" Value="0"/></Style>
        <Style Selector="ListBoxItem:pointerover StackPanel.actions"><Setter Property="Opacity" Value="1"/></Style>
        <Style Selector="ListBoxItem:selected StackPanel.actions"><Setter Property="Opacity" Value="1"/></Style>
        <Style Selector="ListBoxItem:pointerover TextBlock.rowid"><Setter Property="Opacity" Value="0"/></Style>
        <Style Selector="ListBoxItem:selected TextBlock.rowid"><Setter Property="Opacity" Value="0"/></Style>
    </Application.Styles>
</Application>
