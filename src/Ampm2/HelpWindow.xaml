<Window x:Class="Ampm2.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:Ampm2.Help;assembly=Ampm2.Core"
        Title="ampm2 Help" Width="940" Height="660" MinWidth="700" MinHeight="420"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TopicItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Margin="0,1" Padding="12,8">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-10,2,0,2" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- topics -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image x:Name="HelpLogo" Width="26" Height="26" Margin="0,0,9,0"/>
                        <TextBlock Text="ampm2 Help" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="30,6,9,6" TextChanged="Search_Changed"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="11,0,0,0" Foreground="{DynamicResource TextFaint}" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search help" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="NoResults" DockPanel.Dock="Top" Text="No topic matches." Foreground="{DynamicResource TextDim}" Margin="8,4" Visibility="Collapsed"/>
                <ListBox x:Name="TopicList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TopicItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Topic_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type help:HelpTopic}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextDim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- article -->
        <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <ScrollViewer x:Name="ArticleScroll" VerticalScrollBarVisibility="Auto" Padding="28,22,28,26">
                <StackPanel x:Name="Article" MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type help:HelpBlock}">
                                <Grid>
                                    <!-- heading -->
                                    <TextBlock Text="{Binding DisplayText}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,6" TextWrapping="Wrap"
                                               Visibility="{Binding IsHeading, Converter={StaticResource BoolVis}}"/>
                                    <!-- paragraph -->
                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10"
                                               Visibility="{Binding IsParagraph, Converter={StaticResource BoolVis}}"/>
                                    <!-- bullet -->
                                    <DockPanel Margin="2,0,0,7" Visibility="{Binding IsBullet, Converter={StaticResource BoolVis}}">
                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,7,11,0" VerticalAlignment="Top"/>
                                        <TextBlock TextWrapping="Wrap" LineHeight="20">
                                            <Run Text="{Binding Term, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding DisplayText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <!-- step -->
                                    <DockPanel Margin="0,0,0,8" Visibility="{Binding IsStep, Converter={StaticResource BoolVis}}">
                                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" Margin="0,1,0,0"/>
                                    </DockPanel>
                                    <!-- shortcut -->
                                    <DockPanel Margin="0,0,0,7" Visibility="{Binding IsKey, Converter={StaticResource BoolVis}}">
                                        <Border DockPanel.Dock="Left" MinWidth="104" Margin="0,0,12,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,2" CornerRadius="5" Padding="7,1,7,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Term}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" Margin="0,1,0,0"/>
                                    </DockPanel>
                                    <!-- note -->
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,9" Margin="0,4,0,12" Visibility="{Binding IsNote, Converter={StaticResource BoolVis}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{DynamicResource Accent}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20"/>
                                        </DockPanel>
                                    </Border>
                                    <!-- code -->
                                    <Border Background="{DynamicResource LogBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,2,0,12"
                                            Visibility="{Binding IsCode, Converter={StaticResource BoolVis}}">
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
